@page
@model EditModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <form id="registerForm" method="post">

            <span><h3>@Model.FirstName @Model.LastName</h3></span>
            <span><h5>@Model.assignRole.ToUpper()</h5></span>
            <div class="form-floating mb-3">
                
                <select asp-for="@Model.Shift" class="form-control">
                    <option>A</option>
                    <option>B</option>
                    <option>C</option>
                </select>
                <label asp-for="@Model.Shift">Shift</label>
                <span asp-validation-for="@Model.Shift" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">                
                <select asp-for="@Model.Line" class="form-control mb-3" asp-items="@ViewBag.WorkStationName">
                    <option selected disabled>--Select Line--</option>
                    @if (User.IsInRole("manager"))
                    {
                        <option>Production</option>
                        <option>Maintenance</option>
                        <option>Engineering</option>                       
                    }
                    <option>Specialist</option>
                </select>
                <label asp-for="@Model.Line">Line</label>
                <span asp-validation-for="@Model.Line" class="text-danger"></span>
            </div>
            <input type="submit" class="btn btn-primary" value="Save" />
            <a href="/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>

</div>