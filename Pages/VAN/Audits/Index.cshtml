@page
@model             IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <form method="post">
        <input type="submit" value="Create" class="btn btn-primary mb-3" />
    </form>
    <div class="row mb-3">
        <div class="col-md-12">
            <form class="d-flex">
                <select class="form-control me-2" asp-for="Line" asp-items="@ViewBag.WorkStationName"><option selected disabled>--Select Line--</option></select>
                <select class="form-control me-2" asp-for="Shift">
                    <option selected disabled>--Select Shift--</option>
                    <option>A</option>
                    <option>B</option>
                    <option>C</option>
                </select>
                <button class="btn btn-primary" type="submit" asp-page-handler="Audits">Search</button>
            </form>
        </div>
    </div>
    
</p>
<div class="table-responsive card shadow">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].CreatedAt)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Shift)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Auditor)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Line)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Route)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Barcode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Result)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Audits)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedAt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Shift)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Auditor)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Line)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Route)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Barcode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Result)
                    </td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.AuditID">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.AuditID">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.AuditID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            sessionStorage.clear();
        });
    </script>
}
