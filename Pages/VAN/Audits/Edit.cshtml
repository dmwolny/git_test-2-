@page "{id}"
@model             EditModel

@{
    ViewData["Title"] = "Edit";
}

<h4>Audit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Audit.AuditID" />
            <div class="form-group">
                <label asp-for="Audit.CreatedAt" class="control-label"></label>
                @if (User.IsInRole("manager") || User.IsInRole("coordinator")){
                    <input asp-for="Audit.CreatedAt" class="form-control" />
                }
                else
                {
                    <input readonly asp-for="Audit.CreatedAt" class="form-control" />
                }
                <span asp-validation-for="Audit.CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Auditor" class="control-label"></label>
                <input readonly asp-for="Audit.Auditor" class="form-control" />
                <span asp-validation-for="Audit.Auditor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Shift" class="control-label"></label>
                <select asp-for="Audit.Shift" class="form-control">
                    <option>A</option>
                    <option>B</option>
                    <option>C</option>
                </select>
                <span asp-validation-for="Audit.Shift" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Line" class="control-label"></label>
                <select asp-for="Audit.Line" class="form-control" asp-items="ViewBag.WorkStationName"></select>
                <span asp-validation-for="Audit.Line" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Audit Type</label>
                <select asp-for="Type" class="form-control" id="Audit_Type">
                    <option selected disabled>-- Select Audit Type --</option>
                    <option>Weld</option>
                    <option>Sealer</option>
                    <option>Stud</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Model" class="control-label"></label>
                <select asp-for="Audit.Model" class="form-control" asp-items="ViewBag.ModelName">
                </select>
                <span asp-validation-for="Audit.Model" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Route" class="control-label"></label>
                <select asp-for="Audit.Route" class="form-control" asp-items="ViewBag.RouteName">
                </select>
                <span asp-validation-for="Audit.Route" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Barcode" class="control-label"></label>
                @if(Model.Audit.Barcode != "")
                {
                    <input asp-for="Audit.Barcode" class="form-control" />
                    <input type="time" class="form-control" hidden id="time" />
                    <div class="fs-2" hidden><i class="bi bi-123 me-2" id="barcodeIcon" title="Barcode"></i>|<i class="bi bi-clock mx-2" title="Time" id="timeIcon"></i>|<i class="bi bi-clipboard-x ms-2" title="Missed Audit" id="missedIcon"></i></div>
                }
                else
                {
                    <input asp-for="Audit.Barcode" class="form-control" hidden id="barcode" />
                    <input type="time" asp-for="Audit.Barcode" class="form-control" hidden id="time" />

                    <div class="fs-2"><i class="bi bi-123 me-2" id="barcodeIcon" title="Barcode"></i>|<i class="bi bi-clock mx-2" title="Time" id="timeIcon"></i>|<i class="bi bi-clipboard-x ms-2" title="Missed Audit" id="missedIcon"></i></div>                    
                }
                <span asp-validation-for="Audit.Barcode" class="text-danger"></span>
            </div>
            <div class="form-group">
            </div>
            <div class="form-group">
                <label asp-for="Audit.Notes" class="control-label"></label>
                <textarea asp-for="Audit.Notes" class="form-control" >@Model.Audit.Notes</textarea>
                <span asp-validation-for="Audit.Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Audit.Result" class="control-label"></label>
                <input asp-for="Audit.Result" class="form-control" readonly/>
                <span asp-validation-for="Audit.Result" class="text-danger"></span>
            </div>
            @if(Model.Audit.Route.Count() > 0)
            {
                <div class="form-group">
                    <button type="button" class="btn btn-primary my-3" data-bs-toggle="modal" data-bs-target="#weldModal">
                        Add weld concern
                    </button>
                    <input type="submit" value="Submit" class="btn btn-primary"/>
                </div>
            }
            else
            {
                <div class="form-group">
                    <input id="setup" type="submit" value="Setup Audit Route" class="btn btn-primary mt-3" asp-page-handler="setup" disabled />
                </div>
            }

        </form>

        <div>
            <a href="../Index" id="back">Back to List</a>
        </div>
    </div>
    <div class="col-md-8">
        @if (Model.AlertMessage.Length > 0)
        {
            <div class="alert alert alert-warning alert-dismissible fade show" role="alert">
                <strong>@Model.AlertMessage</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label=""></button>
            </div>
        }
        else
        {
            <label class="control-label">List of discrepant welds:</label>           
        }

        <div class="table-responsive card shadow">
            <table class="table">
                <thead>
                    <tr>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].Line)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].Station)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].RobotNumber)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].Style)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].WeldID)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].WeldType)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].NuggetSize)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].Defect)
                        </th>
                        <th class="align-top">
                            @Html.DisplayNameFor(model => model.WeldConcerns[0].TcpID)
                        </th>
                        @if (!User.IsInRole("auditor, supervisor") && Model.WeldConcerns.Where(y => y.TcpID != null).Count() > 0)
                        {
                            <th><a href="/VAN/Tcps/Remove/@Model.Audit.AuditID"><i class="bi bi-trash fs-3 align-top" title="Remove TCP"></i></a></th>
                        }
                        else if (!User.IsInRole("auditor, supervisor"))
                        {
                            <th></th>
                        }

                    </tr>
                </thead>
                <tbody>
                    @if(Model.WeldConcerns != null)
                    {
                        foreach (var item in Model.WeldConcerns)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Line)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Station)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RobotNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Style)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.WeldID)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.WeldType)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NuggetSize)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Defect)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TcpID)
                                </td>
                                @if (!User.IsInRole("auditor, supervisor"))
                                {
                                    <td>
                                        <a asp-page="./Welds/Edit" asp-route-id="@item.WeldConcernID">Edit</a> |
                                        <a asp-page="./Welds/Delete" asp-route-id="@item.WeldConcernID">Delete</a>
                                    </td>                                    
                                }

                            </tr>
                        }    
                    }
                  
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal -->
<div class="modal fade" id="weldModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="weldModalLabel"> Weld Concerns</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="closeIcon"></button>
            </div>
            <div class="modal-body">
                    <form method="post">
                <div class="row">
                    <div class="col-sm-3">
                        <ul>
                            <label class="control-label">Pick a Line</label>
                            <select class="form-control" asp-items="@ViewBag.RouteLine" name="Line" id="Line" asp-for="Line">
                                <option value="">Select Line</option>
                            </select>
                        </ul>
                        <ul>
                            <select class="form-control" id="station" disabled asp-for="Station">
                                <option selected disabled>Select Station</option>
                            </select>
                        </ul>
                        <ul>
                            <select class="form-control" id="robotNumber" disabled asp-for="RobotNumber">
                                <option selected disabled>Select Robot #</option>
                            </select>
                        </ul>
                        <ul>
                            <select class="form-control" id="style" disabled asp-for="Style">
                                <option selected disabled>Select Style</option>
                            </select>
                        </ul>
                    </div>
                    <div class="col-sm-9">
                        <ul id="robotGraphic">                          
                            
                        </ul>
                    </div>
                </div>
               

                
                <button type="button" onclick="getWelds(`?handler=Welds&Line=`)" class="btn btn-primary" id="getWeldsBtn" disabled>Get Welds</button>
                
                <div class="form-check checkbox">
                            <input class="form-check-input" type="checkbox" id="tcpcheckbox" asp-for="TcpCheckbox">
                    <label class="form-check-label" for="tcpcheckbox">
                        TCP
                    </label>
                </div>
                <table class="table" style="display:none;" id="weldList">
                    <thead>
                        <tr>
                            <th>
                                Weld #
                            </th>
                            <th>
                                Weld Type
                            </th>
                            <th>
                                Nugget Size
                            </th>
                            <th>
                                Defect
                            </th>
                        </tr>
                    </thead>
                    <tbody id="welds">
                    </tbody>
                </table>

                <div class="modal-footer" id="modalFooter">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="closeBtn">Close</button>
                    <button type="submit" class="btn btn-primary" id="addBtn" asp-page-handler="AddConcerns" asp-route-tcp="false" disabled>Add</button>
                </div>
                </form>
                

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById('barcodeIcon').addEventListener('click', function () {
            if (document.getElementById('barcode').hasAttribute('hidden')) {
                document.getElementById('time').setAttribute('hidden', true);
                document.getElementById('barcode').removeAttribute('hidden');
            }
            else{
                document.getElementById('barcode').setAttribute('hidden', true);
            }

        });

        document.getElementById('timeIcon').addEventListener('click', function () {
            if (document.getElementById('time').hasAttribute('hidden')) {
                document.getElementById('barcode').setAttribute('hidden', true);
                document.getElementById('time').removeAttribute('hidden');
            }
            else {
                document.getElementById('time').setAttribute('hidden', true);
            }
        });

        document.getElementById('missedIcon').addEventListener('click', function () {
            document.getElementById('barcode').value = "Audit Missed";
            if (document.getElementById('barcode').hasAttribute('hidden')) {
                document.getElementById('time').setAttribute('hidden', true);
                document.getElementById('barcode').removeAttribute('hidden');
            }
            else {
                document.getElementById('barcode').setAttribute('hidden', true);
            }
        });

        document.getElementById('time').addEventListener('change', function () {
            let time = document.getElementById('time').value;
            document.getElementById('barcode').value = time;
            console.log(time);
        })

        document.getElementById("addBtn").addEventListener("click", async function () {
                let tcp = document.getElementById("tcpcheckbox").checked;
                let lineValue = document.getElementById("Line").value;
                let stationValue = document.getElementById("station").value;
                let robotValue = document.getElementById("robotNumber").value;
                let styleValue = document.getElementById("style").value;

                await fetch(`?handler=AddConcerns`,{
                    method: "POST",
                    body: WeldDTO,
                    headers:
                    {
                        "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val()
                    }
                    }).then(response => response.json());
        });

        async function getWelds(handler) {
            let lineValue = document.getElementById("Line").value;
            let stationValue = document.getElementById("station").value;
            let robotValue = document.getElementById("robotNumber").value;
            let styleValue = document.getElementById("style").value;

            //call handler with robot parameters
            const response = await fetch(handler + encodeURIComponent(lineValue)
                + "&Station=" + encodeURIComponent(stationValue)
                + "&RobotNumber=" + encodeURIComponent(robotValue)
                + "&Style=" + encodeURIComponent(styleValue));
            const welds = await response.json();
            var JSONwelds = JSON.parse(welds);

            //if no welds are found for this robot
            //then display a message
            if (JSONwelds[0].WeldID == 0) {
                let warning = document.createElement("div");
                warning.classList = "alert alert-danger alert-dismissible fade show";
                warning.role ="alert";
                let text = document.createTextNode("No welds found associated with this robot");
                warning.appendChild(text);
                document.getElementById("robotGraphic").innerHTML = '';
                document.getElementById("robotGraphic").appendChild(warning);
                document.getElementById("welds").innerHTML = '';
            }
            else //get welds and add them to the welds concern table
            {
                getImage(JSONwelds);
                JSONwelds = JSONwelds.map(row => { return { WeldID: row.WeldID, WeldType: row.WeldType, NuggetSize: row.NuggetSize } });
                tableCreate(JSONwelds);
                document.getElementById("addBtn").removeAttribute('disabled');
            }

        }

        function getImage(JSONobj) {            
            var graphic = document.getElementById("robotGraphic");
            graphic.innerHTML = '';
            graphic.innerHTML += "<img src='/images/" + JSONobj[0].Graphic + "' class='img-fluid'/>";
        }

        function tableCreate(JSONobj) {
            //Make table header visible
            document.getElementById("weldList").removeAttribute("style");
            //Tbody reference
            var body = document.getElementById("welds");
            //remove all child elements
            body.innerHTML = '';


            // create element <tbody>
            var tblBody = document.createElement("tbody");

            // cells creation
            var i = 0;
            JSONobj.forEach((item) => {
                // table row creation
                var row = document.createElement("tr");
                
                for (var key in item) {
                    // create element <td> and text node
                    //Make text node the contents of <td> element
                    // put <td> at end of the table row
                    var cell = document.createElement("td");
                    var formInput = document.createElement("input");
                    formInput.name = "WeldDTO["+i+"]."+key;
                    //formInput.readOnly = true;
                    formInput.value = item[key];
                    formInput.classList = "form-control";
                    formInput.style = "border: 0; pointer-events: none;"
                    var cellText = document.createTextNode(item[key]);

                    cell.appendChild(formInput);
                    row.appendChild(cell);
                }                

                //add dropdown menu to last column
                const drop = defectDropDrop(i);
                var column = document.createElement("td");

                column.appendChild(drop);
                row.appendChild(column);
                //row added to end of table body
                body.appendChild(row);
                i++;
            });
        }

        function defectDropDrop(i) {
            //Create array of options to be added
            var array = ["Indentation", "Misalignment", "Blowthrough", "Scratch", "Edge Weld", "Missing", "Expulsion"];

            //Create and append select list
            var selectList = document.createElement("select");
            selectList.name = "WeldDTO[" + i + "].Graphic";
            selectList.classList = "form-control";
            var first = document.createElement("option");
            first.value = null;
            first.text = "-- Defect --";
            first.disabled = true;
            first.selected = true;
            selectList.appendChild(first);

            //Create and append the options
            for (var i = 0; i < array.length; i++) {
                var option = document.createElement("option");
                option.value = array[i];
                option.text = array[i];
                selectList.appendChild(option);
            }

            return selectList;
        }

        function closeModal() {
            
            //body reference
            document.getElementById("weldList").style.display = 'none';
            var body = document.getElementById("welds");
            //remove all child elements
            body.innerHTML = '';
            //remove image
            var graphic = document.getElementById("robotGraphic");
            graphic.innerHTML = '';
        }


        // EVENT LISTENERS
        // Close the Modal
        document.getElementById("closeBtn").addEventListener("click", function (e) { closeModal() });
        document.getElementById("closeIcon").addEventListener("click", function (e) { closeModal() });

        document.getElementById("tcpcheckbox").addEventListener("click", function (e) {
            if (document.getElementById("tcpcheckbox").checked == true) {
                getWelds(`?handler=TcpWelds&Line=`);
            }
            else {
                getWelds(`?handler=Welds&Line=`);
            }
        });
        // Track changes in the Notes sections
        // save changes to sessionStorage
        let notes = document.getElementById("Audit_Notes");
        notes.addEventListener("change", () => {
            sessionStorage.setItem("notes", notes.value);
        })

        // reset the input values on page refresh
        if (sessionStorage.getItem("notes")) {
            notes.value = sessionStorage.getItem("notes");
        }

        if (sessionStorage.getItem("referer")) {
            document.getElementById('back').href = sessionStorage.getItem("referer");
        }

        var getParentAnchor = function (element) {
            while (element !== null) {
                if (element.tagName && element.tagName.toUpperCase() === "A") {
                    return element;
                }
                element = element.parentNode;
            }
            return null;
        };

        //Clear sessionStorage when user clicks on <a>
        document.querySelector("body").addEventListener('click', function (e) {
            var anchor = getParentAnchor(e.target);
            if (anchor !== null) {
                sessionStorage.clear();
            } false
        });

        //get audit models when user selects Audit_Type
        document.getElementById("Audit_Type").addEventListener("change", function () {
            var lineValue = document.getElementById("Audit_Line").value;
            var typeValue = document.getElementById("Audit_Type").value;
            console.log("change in audit type drope down");

            fetch("?handler=Model&line=" + encodeURIComponent(lineValue) + "&type=" + encodeURIComponent(typeValue))
                .then(function (response) {
                    console.log("get JSON response");
                    return response.json();
                })
                .then(function (data) {
                    var items = '<option value=null selected disabled>Models(Parts)</option>';
                    var stationSelect = document.getElementById("Audit_Model");
                    stationSelect.innerHTML = ''; // Clear previous options

                    //Disable dropdowns 
                    document.getElementById("Audit_Route").setAttribute('disabled', true);

                    //Remove previous data from dropdowns
                    document.getElementById("Audit_Route").innerHTML = '<option value=null selected disabled>Routes</option>';

                    data.forEach(function (lineRobots) {
                        items += "<option value='" + lineRobots.text + "'>" + lineRobots.text + "</option>";
                    });

                    stationSelect.innerHTML = items; // Add new options
                    stationSelect.removeAttribute('disabled');
                })
                .catch(function (error) {
                    console.error('Error fetching Stations:', error);
                });
        });

        //get audit routes when user selects Audit_Model
        document.getElementById("Audit_Model").addEventListener("change", function () {
            var lineValue = document.getElementById("Audit_Line").value;
            var modelValue = document.getElementById("Audit_Model").value;

            fetch("?handler=Route&line=" + encodeURIComponent(lineValue) + "&model=" + encodeURIComponent(modelValue))
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    var items = '<option value=null selected disabled>Routes</option>';
                    var stationSelect = document.getElementById("Audit_Route");
                    stationSelect.innerHTML = ''; // Clear previous options

                    data.forEach(function (lineRobots) {
                        items += "<option value='" + lineRobots.text + "'>" + lineRobots.text + "</option>";
                    });

                    stationSelect.innerHTML = items; // Add new options
                    stationSelect.removeAttribute('disabled');
                })
                .catch(function (error) {
                    console.error('Error fetching Stations:', error);
                });
        });

        //get station numbers when user select line
        document.getElementById("Line").addEventListener("change", function () {
            var lineValue = document.getElementById("Line").value;

            fetch("?handler=Station&Line=" + encodeURIComponent(lineValue))
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    var items = '<option value=null selected disabled>Stations</option>';
                    var stationSelect = document.getElementById("station");
                    stationSelect.innerHTML = ''; // Clear previous options

                    //Disable dropdowns 
                    document.getElementById("robotNumber").setAttribute('disabled', true);
                    document.getElementById("style").setAttribute('disabled', true);
                    document.getElementById("getWeldsBtn").setAttribute('disabled', true);
                    document.getElementById("addBtn").setAttribute('disabled', true);

                    //Remove previous data from dropdowns and the weld concern table
                    document.getElementById("robotNumber").innerHTML = '<option value=null selected disabled>Robot #</option>';
                    document.getElementById("style").innerHTML = '<option value=null selected disabled>Style</option>';
                    document.getElementById("welds").innerHTML = '';
                    document.getElementById("tcpcheckbox").checked = false;

                    data.forEach(function (lineRobots) {
                        items += "<option value='" + lineRobots.text + "'>" + lineRobots.text + "</option>";
                    });

                    stationSelect.innerHTML = items; // Add new options
                    stationSelect.removeAttribute('disabled');
                })
                .catch(function (error) {
                    console.error('Error fetching Stations:', error);
                });
        });

        //get robot numbers when user select line && station
        document.getElementById("station").addEventListener("change", function () {
            var lineValue = document.getElementById("Line").value;
            var stationValue = document.getElementById("station").value

            fetch("?handler=RobotNum&Line=" + encodeURIComponent(lineValue) + "&Station=" + encodeURIComponent(stationValue))
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    var items = '<option value=null selected disabled>Robot #</option>';
                    var robotNumberSelect = document.getElementById("robotNumber");
                    robotNumberSelect.innerHTML = ''; // Clear previous options
                    document.getElementById("welds").innerHTML = '';

                    document.getElementById("style").setAttribute('disabled', true);
                    document.getElementById("getWeldsBtn").setAttribute('disabled', true);
                    document.getElementById("addBtn").setAttribute('disabled', true);
                    document.getElementById("tcpcheckbox").checked = false;

                    document.getElementById("style").innerHTML = '<option value =null selected disabled>Style</option>'

                    data.forEach(function (lineRobots) {
                        items += "<option value='" + lineRobots.text + "'>" + lineRobots.text + "</option>";
                    });

                    robotNumberSelect.innerHTML = items; // Add new options
                    robotNumberSelect.removeAttribute('disabled');
                })
                .catch(function (error) {
                    console.error('Error fetching Robot Numbers:', error);
                });
        });

        //get robot styles when user select line && station && robot #
        document.getElementById("robotNumber").addEventListener("change", function () {
            var lineValue = document.getElementById("Line").value;
            var stationValue = document.getElementById("station").value
            var robotValue = document.getElementById("robotNumber").value

            fetch("?handler=Style&Line=" + encodeURIComponent(lineValue) + "&Station=" + encodeURIComponent(stationValue) + "&RobotNumber=" + encodeURIComponent(robotValue))
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    var items = '<option value=null selected disabled>Style</option>';
                    var robotNumberSelect = document.getElementById("style");
                    robotNumberSelect.innerHTML = ''; // Clear previous options
                    document.getElementById("welds").innerHTML = '';

                    document.getElementById("getWeldsBtn").setAttribute('disabled', true);
                    document.getElementById("addBtn").setAttribute('disabled', true);
                    document.getElementById("tcpcheckbox").checked = false;

                    data.forEach(function (lineRobots) {
                        items += "<option value='" + lineRobots.text + "'>" + lineRobots.text + "</option>";
                    });

                    robotNumberSelect.innerHTML = items; // Add new options
                    robotNumberSelect.removeAttribute('disabled');
                })
                .catch(function (error) {
                    console.error('Error fetching Style:', error);
                });
        });

        document.getElementById("style").addEventListener("change", function () { 
            document.getElementById("getWeldsBtn").removeAttribute('disabled') ;
