@page "{id}"
@model Van_Authentication.Pages.Robots.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Robot</h4>
    <hr />
    <div class="row">
        <div class="col-sm-4">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Robot.Line)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Robot.Line)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Robot.Station)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Robot.Station)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Robot.RobotNumber)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Robot.RobotNumber)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Robot.Style)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Robot.Style)
                </dd>
            </dl>
            
        </div>
        <div class="col">
            <dd class="col-sm-12">
                @if (Model.Robot.Graphic == null)
                {
                    <img src="~/images/default.PNG" class="img-fluid rounded-start shadow" />
                }
                else
                {
                    <img src="~/images/@Model.Robot.Graphic" class="img-fluid rounded-start shadow" />
                }
            </dd>
        </div>
    </div>
</div>

<div class="table-responsive card shadow">
    <table class="table bg-white">
        <thead>
            <tr>
                <th>Weld ID</th>

                <th>Weld Type</th>

                <th>Nugget Size</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.welds != null)
            {
                foreach (var item in Model.welds)
                {
                    <tr>
                        <td>
                            @item.WeldID
                        </td>
                        <td>
                            @item.WeldType
                        </td>
                        <td>
                            @item.NuggetSize
                        </td>
                    </tr>
                }
            }
        </tbody>

    </table>
</div>


<div>
    <a asp-page="./Edit" asp-route-id="@Model.Robot.RobotID">Edit</a> |
    <a asp-page="./Index" asp-route-Line="@Model.Robot.Line">Back to List</a>
</div>
