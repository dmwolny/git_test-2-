@page
@model             AuditsModel
@{
}
<form asp-page-handler="Audits" method="get">
    <div class="row">
        <div class="col-2">
            <div class="form-group">
                <label class="control-label">Date</label>
                <input asp-for="date" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Shift</label>
                <select asp-for="Shift" class="form-control">
                    <option>A</option>
                    <option>B</option>
                    <option>C</option>
                </select>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary my-3">Select</button>
            </div>
        </div>

        <div class="col-10">
            <div class="col-8 card" style="position: relative;"><canvas id="myChart"></canvas></div>
        </div>
    </div>


</form>
<div class="accordion accordion-flush shadow mt-3">

    @if(Model.Parts != null)
    {
        @foreach (var item in Model.Parts)
        {
            var lineItem = item.WorkStationName;
            var typeItem = item.PartModelType;
            var routeList = Model.RouteCount.Where(x => x.Workstation.Equals(lineItem) && x.AuditType.Equals(typeItem)).ToList();
            <div class="accordion-item">
            <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@item.WorkStationName.Replace(" ", "")-@item.PartModelType">
                    @item.WorkStationName @item.PartModelType Audits: 
                        @Model.Audit.Where(y => y.Line.Equals(lineItem) && y.Type.Equals(typeItem) && !y.Result.Equals("Open")).Count()
                        / @item.NumberOfAudits Completed | Explained Loses: @Model.Audit.Where(x => x.Line.Equals(lineItem) && x.Type.Equals(typeItem) && x.Barcode.ToLower().Equals("audit missed")).Count()
                        | Routes: 
                        @foreach (var routeItem in routeList)
                        {
                            var routename = @routeItem.RouteName;
                            <div>&nbsp;@routeItem.RouteName: <b>@Model.Audit.Where(x => x.Route.Equals(routename)).Select(y => y.Route).Count() </b> | </div>
                        }
                    </button>

            </h2>
                <div id="@item.WorkStationName.Replace(" ", "")-@item.PartModelType" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div class="table-responsive card ">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].CreatedAt)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].Shift)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].Auditor)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].Line)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].Route)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].Barcode)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Audits[0].Result)
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var audit in Model.Audit.Where(x => x.Line.Equals(lineItem) && x.Type.Equals(typeItem)))
                            {
                                <tr>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.CreatedAt)
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.Shift)
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.Auditor)
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.Line)
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.Route)
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.Barcode)
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => audit.Result)
                                    </td>
                                    <td>
                                        <a asp-page="../Audits/Edit" asp-route-id="@audit.AuditId" onclick="referer()">Details</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    
                </div>
            </div>
        </div>
        }
        
    }   
</div>
<div class="row mt-3">
    <a asp-page="Index">Back to History</a>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let date = document.getElementById('date').value;
            let shift = document.getElementById('Shift').value;
            
            fetch(`?handler=CompletedData&date=` + encodeURIComponent(date) + "&Shift=" + encodeURIComponent(shift))
                .then(res => res.json())
                .then(jsondata => {
                    console.log(jsondata);

                    var myContext = document.getElementById('myChart').getContext('2d');
                    var myChart = new Chart(myContext, {
                        type: 'bar',
                        data: {
                            labels: jsondata.name,
                            datasets: [{
                                label: 'Weld Audits Completed',
                                backgroundColor: 'rgb(67,170,160,0.8)',
                                data: jsondata.completed,
                                stack: 'Stack 0',
                            }, {
                                label: 'Weld Audits Missed',
                                backgroundColor: 'rgb(254,205,80,0.8)',
                                data: jsondata.missedWeld,
                                stack: 'Stack 0',
                            }, {
                                label: 'Weld Audits Not Completed',
                                backgroundColor: 'rgb(228,35,19,0.8)',
                                data: jsondata.required,
                                stack: 'Stack 0',
                            }, {
                                label: 'Sealer Audits Completed',
                                backgroundColor: 'rgb(67,170,160,0.8)',
                                data: jsondata.completedSealer,
                                stack: 'Stack 1' // For multiple stacking
                            }, {
                                label: 'Sealer Audits Missed',
                                backgroundColor: 'rgb(254,205,80,0.8)',
                                data: jsondata.missedSealer,
                                stack: 'Stack 1',
                            }, {
                                label: 'Sealer Audits Not Completed',
                                backgroundColor: 'rgb(228,35,19,0.8)',
                                data: jsondata.requiredSealer,
                                stack: 'Stack 1' // For multiple stacking
                            }],
                        },
                        options: {
                            plugins: {
                                title: {
                                    display: true,
                                    text: 'Audit Completion'
                                },
                                legend: {
                                    display: false
                                },
                            },
                            interaction: {
                                intersect: false,
                            },
                            scales: {
                                x: {
                                    stacked: true,
                                },
                                y: {
                                    stacked: true
                                }
                            },
                            responsive: true
                        }
                    });

                });
        });

        function referer() {
            sessionStorage.setItem("referer", window.location.pathname + window.location.search);
        }
    </script>
}