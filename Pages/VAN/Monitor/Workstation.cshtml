@page "{pageIndex?}"
@model             WorkstationModel

@{
    ViewData["Title"] = "Workstation History";
}

<h1>Workstation History</h1>

<div class="row mb-12">
    <div class="col-md-7">
        <form class="d-flex">
            <input class="form-control me-2" asp-for="startDate" type="date"/>
            <input class="form-control me-2" asp-for="endDate" type="date" />
            <select class="form-control me-2" asp-for="Workstation" asp-items="ViewBag.WorkStationName">
                <option value="">-- Select Workstation --</option>
            </select>
            <button class="btn btn-primary" type="submit">Search</button>
        </form>
    </div>
    <div class="col-md-5">
        <form method="post">
            <input class="form-control me-2" asp-for="startDate" type="date" hidden/>
            <input class="form-control me-2" asp-for="endDate" type="date" hidden/>
            <select class="form-control me-2" asp-for="Workstation" asp-items="ViewBag.WorkStationName" hidden>
                <option value="">--Select Workstation</option>
            </select>
            <button class="btn btn-link push-right" style="padding:0rem 0rem;" type="submit" asp-page-handler="Export" asp-route-workstation="@Model.Workstation" asp-route-startDate="@Model.startDate" asp-route-endDate="@Model.endDate"><i class="bi bi-file-earmark-arrow-down fs-2"></i></button>
        </form>
    </div>
</div>

<div class="table-responsive card shadow">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].CreatedAt)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Shift)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Auditor)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Line)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Route)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Barcode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Audits[0].Result)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Audits)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedAt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Shift)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Auditor)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Line)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Route)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Barcode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Result)
                    </td>
                    <td>
                        <a asp-page="../Audits/Edit" asp-route-id="@item.AuditID" onclick="referer()">Edit</a> |
                        <a asp-page="../Audits/Details" asp-route-id="@item.AuditID">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav aria-label="Page navigation example">
    <ul class="pagination my-3">
        @if (Model.pageIndex == 1 || Model.pageIndex < 1)
        {

        }
        else
        {
            <li class="page-item">
                <a class="page-link" asp-route-pageIndex="@(Model.pageIndex - 1)" asp-route-Workstation="@Model.Workstation" asp-route-startDate="@Model.startDate" asp-route-endDate="@Model.endDate">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.totalPages; i++)
        {
            var station = ViewBag.WorkstationName;
            string active = "";
            if (i == Model.pageIndex) active = "active";
            <li class="page-item @active" aria-current="page"><a class="page-link" asp-route-pageIndex="@(i)" asp-route-Workstation="@Model.Workstation" asp-route-startDate="@Model.startDate" asp-route-endDate="@Model.endDate" >@i</a></li>
        }
        @if (Model.pageIndex != Model.totalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-route-pageIndex="@(Model.pageIndex + 1)" asp-route-Workstation="@Model.Workstation" asp-route-startDate="@Model.startDate" asp-route-endDate="@Model.endDate">Next</a>
            </li>
        }

    </ul>
</nav>
<div class="row">
    <a asp-page="Index">Back to History</a>
</div>

@section Scripts {
    <script>
        function referer() {
            sessionStorage.setItem("referer", window.location.pathname + window.location.search);
        }

        // Set the minimum Date for endDate Datepicker if user selects a date
        // from the startDate datepicker.
        document.getElementById('startDate').addEventListener('change', function (event) {
            let min = event.target.value;
            let endDate = document.getElementById('endDate');

            endDate.setAttribute('min', min);
        });

        // Set the maximum Date for startDate Datepicker if user selects a date
        // from the endDate datepicker.
        document.getElementById('endDate').addEventListener('change', function (event) {
            let max = event.target.value;
            let startDate = document.getElementById('startDate');

            startDate.setAttribute('max', max);
        })
    </script>
}