@page
@model             EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>AuditRoute</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AuditRoute.AuditRouteId" />
            <div class="form-group">
                <label asp-for="AuditRoute.AuditRouteName" class="control-label"></label>
                <input asp-for="AuditRoute.AuditRouteName" class="form-control" />
                <span asp-validation-for="AuditRoute.AuditRouteName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AuditRoute.PartModelId" class="control-label"></label>
                <select asp-for="AuditRoute.PartModelId" class="form-control" asp-items="ViewBag.PartModelId"></select>
                <span asp-validation-for="AuditRoute.PartModelId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary mt-2" />
            </div>
        </form>
    </div>
</div>

<a asp-page="./Welds/Add" asp-route-routeID="@Model.AuditRoute.AuditRouteId" class="btn btn-primary my-2">Add Welds to Route</a>
<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
