@page
@model Van_Authentication.Pages.Audits.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Audit</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.CreatedAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.Shift)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Shift)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.Auditor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Auditor)
        </dd>
        <dt class="col-sm-2">
            Workstation
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Line)
        </dd>
        <dt class="col-sm-2">
            Model(Part)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Model)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.Route)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Route)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.Barcode)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Barcode)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.Notes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Notes)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Audit.Result)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Audit.Result)
        </dd>
    </dl>
</div>

<div class="table-responsive card shadow">
    <table class="table">
        <thead>
            <tr>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].Line)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].Station)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].RobotNumber)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].Style)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].WeldID)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].WeldType)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].NuggetSize)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].Defect)
                </th>
                <th class="align-top">
                    @Html.DisplayNameFor(model => model.WeldConcerns[0].TcpID)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.WeldConcerns != null)
            {
                foreach (var item in Model.WeldConcerns)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Line)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Station)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.RobotNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Style)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.WeldID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.WeldType)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.NuggetSize)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Defect)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TcpID)
                        </td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.AuditID">Edit</a> |
                            <a asp-page="./Delete" asp-route-id="@item.AuditID">Delete</a>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Audit.AuditID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
