            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Style)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Defect)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Audit.Auditor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tcp.Status)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.WeldConcernID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.WeldConcernID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.WeldConcernID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
