            <th>
                @Html.DisplayNameFor(model => model.WeldConcern[0].Style)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeldConcern[0].Defect)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeldConcern[0].Audit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeldConcern[0].Tcp)
            </th>
            <th></th>
        </tr>
