@page
@model Van_Authentication.Pages.Admin.Routes.Welds.AddModel

@{
    ViewData["Title"] = "Add Weld to Route";
}

<h1>Add</h1>

<h4>Welds to Route</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Route Name</label>
                <select asp-for="@Model.id" class ="form-control" asp-items="ViewBag.AuditRouteId"></select>
            </div>
            <div class="form-group">
                <label asp-for="AuditRouteWeld.WeldId" class="control-label"></label>
                <select asp-for="AuditRouteWeld.WeldId" class ="form-control" asp-items="ViewBag.WeldId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="../Details" asp-route-id="@Model.id">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
