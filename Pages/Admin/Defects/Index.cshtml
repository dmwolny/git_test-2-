@page
@model Van_Authentication.Pages.Admin.Defects.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Weld Defects</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>
<div class="table-responsive card shadow">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Defect[0].DefectDesc)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Defect[0].DefectType)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Defect)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.DefectDesc)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DefectType)
                    </td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.DefectID">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.DefectID">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.DefectID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

