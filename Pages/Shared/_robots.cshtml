@model Van_Authentication.Pages.Audits.EditModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
} 
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.welds[0].WeldID)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.welds[0].WeldType)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.welds[0].NuggetSize)
                </th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
        @if(Model.welds != null)
        {
            foreach (var item in Model.welds)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.WeldID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.WeldType)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NuggetSize)
                    </td>
                    <td>
                        Defect
                    </td>
                </tr>
            }
        }
        
        </tbody>
    </table>
