@page
@model Van_Authentication.Pages.IndexModel
@{
    ViewData["Title"] = "BIW Homepage";
}
<div class="container col-xxl-12 py-5 card">
    <div class="row flex-lg-row-reverse align-items-center g-5 pt-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="/images/logos/IMG_8595.jpg" class="d-block mx-lg-auto img-fluid rounded shadow" alt="BIW" width="700" height="500" loading="lazy">
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">Body In White</h1>
            <p class="lead">Welcome to the site for BIW. Here you can manage various aspects of our daily acitivities such as Weld Audits, certifications for welds, ISD, tracking 4Ps. Use the site from anywhere in the plant to look up critical data, collaboratively write shift notes.</p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <button type="button" class="btn btn-primary btn-lg px-4 me-md-2">Primary</button>
                <button type="button" class="btn btn-outline-secondary btn-lg px-4">Default</button>
            </div>
        </div>
    </div>

    <div class="row col-xxk-8 flex-lg-row align-items-center g-5 pt-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="/images/logos/van profile.png" class="d-block mx-lg-auto img-fluid rounded-circle shadow-lg" alt="BIW" width="230" height="230" loading="lazy">
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">Meet VAN, BIW's own AI</h1>
            <p class="lead">Leverage the power of AI. Use BIW's own AI assistant (VAN) to find info on standards, processes or technical specs.​</p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a href="/AskVAN" type="button" class="btn btn-primary btn-lg px-4 me-md-2">Say Hi to VAN</a>
            </div>
        </div>
    </div>
</div>