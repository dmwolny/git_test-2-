@page
@model Van_Authentication.Pages.NotesModel
@{
}
<div class="container col-xxl-8 px-4 py-5">
    <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
        <div class="col-10 col-sm-8 col-lg-6">
            <img src="~/images/logos/robots.svg" class="d-block mx-lg-auto img-fluid" loading="lazy" />
        </div>
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">Shift Notes</h1>
            <p class="lead">
                Collaborate with your team in real time to document SQDCM for your team's end of shift notes.
            </p>
            <a asp-page="/Engineering/Index" class="btn btn-primary  px-4 mb-2 me-md-2">Engineering</a>
            <a asp-page="/Maintenance/Index" class="btn btn-primary px-4 mb-2 me-md-2">Maintenance</a>
            <a asp-page="/Production/Index" class="btn btn-primary px-4 mb-2 me-md-2">Production</a>
        </div>
    </div>
</div>
