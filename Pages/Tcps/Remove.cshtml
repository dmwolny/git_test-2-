@page "{id}"
@model Van_Authentication.Pages.Tcps.RemoveModel
@{
    ViewData["Title"] = "Remove TCP";
}

<h1>Remove TCP</h1>
<p></p>

<div class="accordion accordion-flush" id="accordionFlushExample">
    @foreach(var item in Model.TcpList)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-@item.TcpID" aria-expanded="false" aria-controls="flush-collapseOne">
                    Line: @item.Line Station: @item.Station Robot#: @item.RobotNumber TCP#: @item.TcpID Defect: @item.Defect
                </button>
            </h2>
            <div id="flush-@item.TcpID" class="accordion-collapse collapse show" aria-labelledby="flush-@item.TcpID" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">
                    <form method="post">
                        <div class="form-group col-lg-3 mb-2">
                            <label asp-for="Notes" class="control-label"></label>
                            <textarea class="form-control" asp-for="Notes"></textarea>
                            <span class="text-danger">@TempData["error"]</span>
                        </div>
                        <button type="submit" class="btn btn-primary" asp-page-handler="Remove" asp-route-tcpId="@item.TcpID" asp-route-notes="Notes">Remove</button>
                    </form>
                    
                </div>
            </div>
        </div>
    } 
</div>